# Copy to .env and fill in. Never commit .env. Variables are described in docs/contracts.md.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings
PAYPAL_WEBHOOK_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Model swap layer
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5

# SQLite locally; Render Postgres URL when hosted
DATABASE_URL=sqlite:///./quietcheck.db
