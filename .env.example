# Copy to .env and fill in. Never commit .env. Variables are described in docs/contracts.md.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings
PAYPAL_WEBHOOK_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Model swap layer
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5

# SQLite locally; Render Postgres URL when hosted
DATABASE_URL=sqlite:///./quietcheck.db

# Web server -> backend (the browser never calls the backend; default http://127.0.0.1:8000)
# BACKEND_URL=
# Signs the review copilot's Approve/Deny requests (D6). Optional locally; set it when hosted (openssl rand -base64 32)
# TOOL_APPROVAL_SECRET=

# Consortium member lists and keys (default backend/var/members; `make seed` writes the lists)
# MEMBER_DATA_DIR=

# Demo personas (D7): the three sandbox buyer accounts' emails, one per persona. Never commit them.
PERSONA_ANA_EMAIL=
PERSONA_BEN_EMAIL=
PERSONA_CY_EMAIL=

# Hosted on Render only (D9; render.yaml sets these, see docs/contracts.md). Leave unset locally.
# BACKEND_API_TOKEN=        # backend bearer token; web and workflow send it
# BACKEND_HOST=             # web/workflow: backend's internal hostname
# CONSOLE_PASSWORD=         # web: /console password (HTTP Basic)
# RENDER_API_KEY=           # backend: starts Render Workflows task runs
# RISK_WORKFLOW_TASK=       # backend: the risk workflow's task ID, e.g. quietcheck-risk/process_order
# INITIATOR_PRIVATE_KEY=    # backend: AP3 key, 32 bytes base64 or hex
# MEMBER_PRIVATE_KEY=       # each member: AP3 key, 32 bytes base64 or hex
# MEMBER_A_HOST= MEMBER_B_HOST= MEMBER_C_HOST=   # backend: members' internal hostnames
# MEMBER_DATA_HASHES=       # backend: expected member list digests (scripts/seed.py --digests)
# INITIATOR_URL_PATTERN=    # each member: allowed initiator URLs (full-match regex)

# Written by scripts/render_setup.sh: the hosted demo's public URLs
# HOSTED_BACKEND_URL=
# HOSTED_WEB_URL=
